{
  "version": 1,
  "allowPaid": false,
  "timeoutSeconds": 1800,
  "steps": [
    { "op": "load", "look": "samples/luxor.look.json", "options": { "atlasSize": 2048, "viewSize": 1024 } },
    { "op": "run", "saveAs": "luxor-first-run", "options": {
      "nameParts": false, "references": 0, "check": false, "checkPlanes": false,
      "plan": { "maxViews": 4, "holes": 0, "cleanup": 0, "roofs": 0, "floors": 0 }
    } },
    { "op": "finish" },
    { "op": "save", "id": "luxor-first-run" },
    { "op": "export", "output": "luxor-textured.glb" }
  ]
}
