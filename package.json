{
  "name": "potemkin3d",
  "version": "0.2.0",
  "description": "AI-painted 3D environments, view-aware texture atlases and real-time walkthroughs, extending Patch Trompe.",
  "license": "Apache-2.0",
  "repository": "github:wrong-nebula/potemkin3D",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "texture": "node scripts/texture.mjs",
    "capture": "node scripts/capture.mjs",
    "pbr": "node scripts/pbr.mjs",
    "measure": "node scripts/measure.mjs",
    "validate": "node scripts/validate.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:compare": "node scripts/benchmark-run.mjs",
    "build:scenes": "node scripts/build-potemkin.mjs",
    "cli": "node automation/cli.mjs",
    "mcp": "node automation/mcp.mjs",
    "test:automation": "vitest run test/automation.test.js",
    "check:automation": "node scripts/check-automation.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@pierre/highlights": "^0.5.1",
    "@pierre/words": "^0.2.2",
    "@ui-sdk/core": "^0.1.0-beta.10",
    "@ui-sdk/web": "^0.1.0-beta.10",
    "comlink": "4.4.2",
    "pele": "^1.13.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "xatlasjs": "0.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "x-potemkin-notice": "Modified from Patch Trompe by the Potemkin contributors; see NOTICE and PROVENANCE.md.",
  "bin": {
    "potemkin": "automation/cli.mjs",
    "potemkin-mcp": "automation/mcp.mjs"
  }
}
